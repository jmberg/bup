#!/usr/bin/env bash
. ./wvtest-bup.sh
. ./test/lib/btl.sh

set -o pipefail

top="$(WVPASS pwd)" || exit $?
tmpdir="$(WVPASS wvmktempdir)" || exit $?

export BUP_DIR="$tmpdir/bup"
export GIT_DIR="$tmpdir/bup"

bup() { "$top/bup" "$@"; }

WVPASS bup init
WVPASS cd "$tmpdir"

WVPASS bup index "$top/test/sampledata"
WVPASS bup save -n main "$top/test/sampledata"
WVPASSEQ "$(git tag)" ''
WVFAIL err-to log bup tag -d nope
WVPASS grep "error: tag 'nope' doesn't exist" log
WVPASSEQ "$(git tag)" ''
WVPASS bup tag -f -d nope
WVPASSEQ "$(git tag)" ''
WVFAIL bup tag tag-1
WVPASSEQ "$(git tag)" ''
WVFAIL bup tag '' nope
WVPASSEQ "$(git tag)" ''
WVFAIL err-to log bup tag tag-1 nope
WVPASS grep "error: commit nope not found" log
WVPASSEQ "$(git tag)" ''
WVFAIL err-to log bup tag .tag-1 main
WVPASS grep ".tag-1 is not a valid tag name" log
WVPASSEQ "$(git tag)" ''
WVPASS bup tag tag-1 main
WVPASSEQ "$(git tag)" tag-1
WVFAIL err-to log bup tag tag-1 main
WVPASS grep -E "tag tag-1 already exists" log
WVPASSEQ "$(git tag)" tag-1
WVPASS bup tag -d tag-1
WVPASSEQ "$(git tag)" ''

WVFAIL err-to log env BUP_DIR="$tmpdir/missing" "$top/bup" tag
WVPASS test -n "$(cat log)"

WVSTART "tag -r"
WVPASS mkdir second
WVPASS echo second > second/file
WVPASS bup index second
WVPASS bup save -n second --strip second
WVPASSEQ "$(bup tag -r -:"$BUP_DIR")" ''
WVPASS bup tag -r -:"$BUP_DIR" tag-r main
WVPASSEQ "$(git tag)" tag-r
WVPASSEQ "$(bup tag -r -:"$BUP_DIR")" tag-r
WVFAIL err-to log bup tag -r -:"$BUP_DIR" tag-r second
WVPASS grep -E "tag tag-r already exists" log
WVPASSEQ "$(git rev-parse refs/tags/tag-r)" "$(git rev-parse main)"
WVPASS bup tag -r -:"$BUP_DIR" -f tag-r second
WVPASSEQ "$(git rev-parse refs/tags/tag-r)" "$(git rev-parse second)"
WVFAIL err-to log bup tag -r -:"$BUP_DIR" tag-x nope
WVPASS grep "error: commit nope not found" log
WVPASS bup tag -r -:"$BUP_DIR" -d tag-r
WVPASSEQ "$(git tag)" ''
WVPASSEQ "$(bup tag -r -:"$BUP_DIR")" ''

WVPASS cd "$top"
WVPASS rm -rf "$tmpdir"
